# === LLM Provider ===
# Providers: gemini | openrouter | openai_compat  (see docs/DECISIONS.md D-026, D-028..D-030)
# Models today ($0, free tiers): LLM gemini / gemini-3.5-flash-lite,
#   FALLBACK openrouter / qwen/qwen3.8-27b:free, JUDGE gemini / gemini-3.1-flash-lite
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# openai_compat only: endpoint root serving /chat/completions. https anywhere; http only for
# localhost/127.0.0.1 (empty API key allowed only then). See docs/dev/DEPLOY.md section 8.
LLM_BASE_URL=
# Per-call timeout in seconds
LLM_TIMEOUT_S=20
# free = keys on free tiers: actual cost logged as 0 next to the list-price cost (D-031).
# paid = actual cost is the list price. The code default is paid.
LLM_BILLING=free

# === Fallback LLM ===
FALLBACK_PROVIDER=
FALLBACK_API_KEY=
FALLBACK_MODEL=
FALLBACK_BASE_URL=

# === Judge LLM (verification) ===
JUDGE_PROVIDER=
JUDGE_API_KEY=
JUDGE_MODEL=
JUDGE_BASE_URL=

# === Security ===
ALLOWED_ORIGINS=
RATE_LIMIT_PER_MIN=30
MAX_TEXT_CHARS=4000
# Response cache, 1 hour (D-039). Set false on a server used for evaluation runs (D-059)
RESPONSE_CACHE=true
# Hadith references from dorar.net for the reviewer, off | dorar (D-067). Keep off until the
# content owner has checked a sample and Dorar's terms of use
HADITH_LOOKUP=off
# Proxies in front of the app that append to X-Forwarded-For (Render: 1; local: 0)
TRUSTED_PROXY_HOPS=0
# LLM consumption limits (D-034): segments translated per request (the rest comes back
# untranslated, in review), routed LLM calls per request, seconds after which a request starts
# no new LLM call, routed LLM calls per UTC day for the whole process
MAX_SEGMENTS=6
LLM_CALL_BUDGET=28
REQUEST_DEADLINE_S=90
LLM_DAILY_CALL_BUDGET=1000
# Each provider's own cap on HTTP requests per UTC day, retries included (D-066); 0 = no cap.
# The fallback default 45 keeps OpenRouter's free tier (50/day); raise it for a paid key.
LLM_DAILY_LIMIT=0
FALLBACK_DAILY_LIMIT=45
JUDGE_DAILY_LIMIT=0

# === Environment ===
ENV=development

# === Google Translate (optional, for eval baseline) ===
GT_API_KEY=
